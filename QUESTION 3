#include <stdio.h>

#define MAX 5

int main()
{
    int deque[MAX];
    int front = 2, rear = 2;
    int i;

    deque[front] = 10;

    rear++;
    deque[rear] = 20;

    front--;
    deque[front] = 30;

    front++;

    rear--;

    printf("Remaining elements: ");

    for(i = front; i <= rear; i++)
    {
        printf("%d ", deque[i]);
    }

    return 0;
}
