#include <stdio.h>

int main()
{
    int stack[5];
    int top = -1;

    top++;
    stack[top] = 10;

    top++;
    stack[top] = 20;

    top++;
    stack[top] = 30;

    printf("Stack: ");

    for(int i = top; i >= 0; i--)
    {
        printf("%d ", stack[i]);
    }

    return 0;
}

output:-Stack: 30 20 10
