#include <stdio.h>

int main()
{
    int data[3] = {10, 20, 30};
    int priority[3] = {2, 1, 3};
    int i, highest = 0;

    for(i = 1; i < 3; i++)
    {
        if(priority[i] < priority[highest])
        {
            highest = i;
        }
    }

    printf("Deleted element: %d\n", data[highest]);

    printf("Remaining elements:\n");

    for(i = 0; i < 3; i++)
    {
        if(i != highest)
        {
            printf("Element = %d, Priority = %d\n",
                   data[i], priority[i]);
        }
    }

    return 0;
}
